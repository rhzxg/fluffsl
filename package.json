{
	"name": "fluffsl",
	"displayName": "fluffsl",
	"description": "Unofficial VSCode syntax highlighting extension for The-Forge Shading Language (FSL)",
	"author": "rhzxg",
	"license": "MIT",
	"version": "2.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/rhzxg/fluffsl.git"
	},
	"publisher": "rhzxg",
	"categories": ["Programming Languages"],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"activationEvents": [
		"onLanguage:fsl"
	],
	"main": "./client/out/extension",
	"contributes": {
		"languages": [{
			"id": "fsl",
			"aliases": ["The-Forge Shading Language", "FSL"],
			"extensions": [".fsl"],
			"configuration": "./language-configuration.json"
		}],
		"grammars": [{
			"language": "fsl",
			"scopeName": "source.fsl",
			"path": "./syntaxes/fsl.tmLanguage.json"
		}],
		"configuration": {
			"type": "object",
			"title": "The-Forge Shading Language",
			"properties": {
				"fsl.forgeRoot": {
					"scope": "machine-overridable",
					"type": "string",
					"default": "",
					"description": "Path to Common_3/Tools/ForgeShadingLanguage. Built-in functions, macros, and types are extracted from its include headers."
				},
				"fsl.includePaths": {
					"scope": "resource",
					"type": "array",
					"items": { "type": "string" },
					"default": [],
					"description": "Additional directories searched for FSL #include and #import files."
				},
				"fsl.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the language server."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"test": "npm run compile && node ./client/out/test/runTest.js"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"eslint": "^9.13.0",
		"mocha": "^10.3.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}
